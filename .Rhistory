getwd()
exists("load_heartrate_data", mode = "function")
exists("load_activity_data", mode = "function")
files <- list.files(
"R",
pattern = "\\.[Rr]$",
recursive = TRUE,
full.names = TRUE
)
for (f in files) {
lines <- readLines(f, warn = FALSE)
if (any(grepl(
"load_heartrate_data\\s*<-\\s*function",
lines
))) {
cat("Function defined in:", f, "\n")
}
}
