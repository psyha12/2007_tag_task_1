Files looking at:

- `minuteIntensitiesWide_merged`
- `minuteStepsNarrow_merged`
- `minuteStepsWide_merged`

```{r setup, message=FALSE}
library(readr)
library(dplyr)
library(tidyr)
library(ggplot2)

knitr::opts_chunk$set(message = FALSE, warning = FALSE)
```

### Load Data

```{r load}
DATA_LOC <- "../data/"

minute_intensities_wide <- read_csv(paste0(DATA_LOC, "minuteIntensitiesWide_merged.csv"))
minute_steps_narrow     <- read_csv(paste0(DATA_LOC, "minuteStepsNarrow_merged.csv"))
minute_steps_wide       <- read_csv(paste0(DATA_LOC, "minuteStepsWide_merged.csv"))

datasets <- list(minute_intensities_wide = minute_intensities_wide,
                 minute_steps_narrow     = minute_steps_narrow,
                 minute_steps_wide       = minute_steps_wide)
```

### Missing Values

```{r missing}
for (name in names(datasets)) {
  na_counts <- colSums(is.na(datasets[[name]]))
  cat("\n", name, ":\n", sep = "")
  print(na_counts[na_counts > 0])
}
```

### Duplicate Rows

```{r duplicates}
