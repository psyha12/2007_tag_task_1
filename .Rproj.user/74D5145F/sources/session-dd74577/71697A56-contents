This notebook creates two plots for the Fitbit group dashboard: hourly calories burned and a comparison of activity intensity. The plots use participant IDs rather than names.

## 1. Load the data

Put the three CSV files in a `data` folder next to this R Markdown file (or in the same folder). Install the packages once if needed:

```r
install.packages(c("dplyr", "tidyr", "ggplot2", "readr"))
```

```{r setup, message=FALSE, warning=FALSE}
library(dplyr)
library(tidyr)
library(ggplot2)
library(readr)

knitr::opts_chunk$set(echo = TRUE, warning = FALSE, message = FALSE,
                      fig.width = 10, fig.height = 5, dpi = 120)

find_csv <- function(filename, alternative = NULL) {
  candidates <- c(file.path("data", filename), filename)
  if (!is.null(alternative)) {
    candidates <- c(candidates, file.path("data", alternative), alternative)
  }
  found <- candidates[file.exists(candidates)]
  if (length(found) == 0) stop(paste("File not found:", filename))
  found[1]
}

cal_narrow <- read_csv(find_csv("minuteCaloriesNarrow_merged.csv"),
                       col_types = cols(Id = col_character(),
                                        ActivityMinute = col_character(),
                                        Calories = col_double()))
cal_wide <- read_csv(find_csv("minuteCaloriesWide_merged.csv",
                           "minuteCaloriesWide_merged (1).csv"),
                     col_types = cols(.default = col_double(),
                                      Id = col_character(), ActivityHour = col_character()))
intensity <- read_csv(find_csv("minuteIntensitiesNarrow_merged.csv"),
                      col_types = cols(Id = col_character(),
                                       ActivityMinute = col_character(),
                                       Intensity = col_integer()))

parse_time <- function(x) {
  result <- as.POSIXct(x, format = "%m/%d/%Y %I:%M:%S %p", tz = "UTC")
  if (anyNA(result)) stop("Some timestamps could not be parsed")
  result
}
cal_narrow$ActivityMinute <- parse_time(cal_narrow$ActivityMinute)
cal_wide$ActivityHour <- parse_time(cal_wide$ActivityHour)
intensity$ActivityMinute <- parse_time(intensity$ActivityMinute)
```

## 2. Prepare the data

The calorie files contain overlapping readings. Check that they agree, then combine them without counting the same minute twice. The time zone is set to UTC for consistent handling of the recorded timestamps; this does not establish the athletes' actual time zones.

```{r prepare}
minute_cols <- sprintf("Calories%02d", 0:59)
stopifnot(all(minute_cols %in% names(cal_wide)))
stopifnot(!anyDuplicated(cal_narrow[c("Id", "ActivityMinute")]))
stopifnot(!anyDuplicated(cal_wide[c("Id", "ActivityHour")]))
stopifnot(!anyDuplicated(intensity[c("Id", "ActivityMinute")]))
stopifnot(all(!is.na(cal_narrow$Calories) & cal_narrow$Calories >= 0))
stopifnot(all(!is.na(intensity$Intensity) & intensity$Intensity %in% 0:3))

wide_minutes <- cal_wide %>%
  pivot_longer(cols = all_of(minute_cols), names_to = "minute", values_to = "Calories_wide") %>%
  mutate(ActivityMinute = ActivityHour + as.integer(sub("Calories", "", minute)) * 60) %>%
  select(Id, ActivityMinute, Calories_wide)

combined <- full_join(cal_narrow, wide_minutes, by = c("Id", "ActivityMinute"))
matched <- !is.na(combined$Calories) & !is.na(combined$Calories_wide)
if (any(abs(combined$Calories[matched] - combined$Calories_wide[matched]) >
        1e-6 + 1e-6 * abs(combined$Calories_wide[matched]))) {
  stop("Overlapping calorie values disagree. Check the source files.")
}

calories <- combined %>%
  mutate(Calories = coalesce(Calories, Calories_wide)) %>%
  filter(!is.na(Calories)) %>%
  select(Id, ActivityMinute, Calories)
stopifnot(!anyDuplicated(calories[c("Id", "ActivityMinute")]))
stopifnot(all(calories$Calories >= 0))

# Keep only hours with at least 45 recorded minutes.
min_minutes <- 45
hourly <- calories %>%
  mutate(date = as.Date(ActivityMinute, tz = "UTC"),
         hour = as.integer(format(ActivityMinute, "%H", tz = "UTC"))) %>%
  group_by(Id, date, hour) %>%
  summarise(calories = sum(Calories), recorded_minutes = n(), .groups = "drop")
stopifnot(all(hourly$recorded_minutes >= 1 & hourly$recorded_minutes <= 60))
eligible_hourly <- hourly %>% filter(recorded_minutes >= min_minutes)

intensity_daily <- intensity %>%
  mutate(date = as.Date(ActivityMinute, tz = "UTC")) %>%
  count(Id, date, Intensity, name = "minutes")

ids <- sort(intersect(unique(calories$Id), unique(intensity$Id)))
shared_dates <- sort(intersect(unique(hourly$date), unique(intensity_daily$date)))
stopifnot(length(ids) > 0, length(shared_dates) > 0)
cat("Participant IDs:", length(ids), "\n")
cat("Combined calorie minutes:", nrow(calories), "\n")
cat("Intensity minutes:", nrow(intensity), "\n")
```

## 3. Plot 1: Hourly calories

This plot compares one participant's hourly calorie total with the mean for the other participants on the same date. The comparison only uses hours with at least 45 recorded minutes per participant.

```{r calorie-plot-function}
plot_hourly_calories <- function(participant_id, selected_date) {
  participant_id <- as.character(participant_id)
  selected_date <- as.Date(selected_date)
  if (!participant_id %in% ids) stop("Unknown participant ID")
  if (is.na(selected_date)) stop("Invalid date")

  person <- eligible_hourly %>%
    filter(Id == participant_id, date == selected_date) %>%
    select(hour, athlete_calories = calories)
  peers <- eligible_hourly %>%
    filter(Id != participant_id, date == selected_date) %>%
    group_by(hour) %>%
    summarise(peer_mean = mean(calories), .groups = "drop")
  plot_data <- tibble(hour = 0:23) %>%
    left_join(person, by = "hour") %>%
    left_join(peers, by = "hour") %>%
    pivot_longer(c(athlete_calories, peer_mean),
                 names_to = "series", values_to = "calories") %>%
    mutate(series = factor(series,
                           levels = c("athlete_calories", "peer_mean"),
                           labels = c("Selected athlete", "Mean of other athletes"))) %>%
    group_by(series) %>%
    mutate(segment = cumsum(is.na(calories))) %>%
    ungroup()

  if (all(is.na(plot_data$calories))) stop("No eligible calorie records for this date")

  ggplot(plot_data, aes(x = hour, y = calories, colour = series,
                        linetype = series, group = interaction(series, segment))) +
    geom_line(linewidth = 0.9, na.rm = TRUE) +
    geom_point(size = 1.6, na.rm = TRUE) +
    scale_x_continuous(breaks = seq(0, 22, 2),
                       labels = sprintf("%02d:00", seq(0, 22, 2)), limits = c(0, 23)) +
    scale_y_continuous(limits = c(0, NA), expand = expansion(mult = c(0, 0.06))) +
    scale_colour_manual(values = c("Selected athlete" = "#2563eb",
                                   "Mean of other athletes" = "#ea580c")) +
    scale_linetype_manual(values = c("Selected athlete" = "solid",
                                     "Mean of other athletes" = "dashed")) +
    labs(title = paste("Hourly calories burned |", participant_id, "|",
                       format(selected_date, "%d %b %Y")),
         x = "Hour of day", y = "Total calories (kcal per recorded hour)",
         colour = NULL, linetype = NULL,
         caption = paste0("At least ", min_minutes,
                          "/60 recorded minutes required per hour. Gaps indicate insufficient data.\n",
                          "Peer mean excludes the selected athlete; peer count may vary by hour.")) +
    theme_minimal(base_size = 11) +
    theme(legend.position = "top", plot.caption = element_text(hjust = 0, size = 9),
          panel.grid.minor = element_blank())
}
```

Choose an ID and a date below. The defaults use the first available eligible hourly record, so the example should produce a plot.

```{r calorie-example}
example_hour <- eligible_hourly %>% arrange(date, Id, hour) %>% slice(1)
selected_id <- example_hour$Id[[1]]  # Change to another ID from ids
selected_date <- example_hour$date[[1]]  # Change to a date, e.g. as.Date("2016-04-12")
plot_hourly_calories(selected_id, selected_date)
```

## 4. Plot 2: Activity intensity

This chart compares up to five participants. Each bar shows the percentage of their recorded minutes at each intensity level, so differences in recording time do not automatically make one bar larger.

```{r intensity-plot-function}
plot_intensity_comparison <- function(participant_ids, start_date, end_date) {
  participant_ids <- as.character(participant_ids)
  start_date <- as.Date(start_date)
  end_date <- as.Date(end_date)
  if (length(participant_ids) < 1 || length(participant_ids) > 5 ||
      anyDuplicated(participant_ids)) stop("Select 1 to 5 different IDs")
  if (any(!participant_ids %in% ids)) stop("Unknown participant ID")
  if (is.na(start_date) || is.na(end_date) || end_date < start_date)
    stop("Check the start and end dates")

  counts <- intensity_daily %>%
    filter(Id %in% participant_ids, date >= start_date, date <= end_date) %>%
    group_by(Id, Intensity) %>%
    summarise(minutes = sum(minutes), .groups = "drop") %>%
    complete(Id = participant_ids, Intensity = 0:3, fill = list(minutes = 0)) %>%
    group_by(Id) %>%
    mutate(total_minutes = sum(minutes),
           percentage = if_else(total_minutes > 0, 100 * minutes / total_minutes, NA_real_)) %>%
    ungroup() %>%
    filter(total_minutes > 0) %>%
    mutate(Id = factor(Id, levels = rev(participant_ids)),
           level = factor(Intensity, levels = 0:3,
                          labels = c("Sedentary", "Light", "Fairly active", "Very active")))
  if (nrow(counts) == 0) stop("No intensity records for this selection")
  check <- counts %>% group_by(Id) %>% summarise(total = sum(percentage), .groups = "drop")
  stopifnot(all(abs(check$total - 100) < 1e-8))

  totals <- counts %>% distinct(Id, total_minutes)
  ggplot(counts, aes(x = percentage, y = Id, fill = level)) +
    geom_col(width = 0.65, colour = "white", linewidth = 0.3) +
    geom_text(data = totals,
              aes(x = 101, y = Id, label = paste0(format(total_minutes, big.mark = ","), " min")),
              inherit.aes = FALSE, hjust = 0, size = 3) +
    scale_x_continuous(breaks = seq(0, 100, 20),
                       labels = function(x) paste0(x, "%"), limits = c(0, 125),
                       expand = expansion(mult = c(0, 0))) +
    scale_fill_manual(values = c("Sedentary" = "#cbd5e1", "Light" = "#60a5fa",
                                 "Fairly active" = "#f59e0b", "Very active" = "#16a34a")) +
    labs(title = paste("Activity intensity |", format(start_date, "%d %b %Y"),
                       "to", format(end_date, "%d %b %Y")),
         x = "Percentage of recorded minutes (%)", y = "Participant ID", fill = "Intensity",
         caption = "Labels on the right show recorded minutes. Unrecorded time is excluded.") +
    theme_minimal(base_size = 11) +
    theme(legend.position = "bottom", plot.caption = element_text(hjust = 0, size = 9),
          panel.grid.major.y = element_blank(), panel.grid.minor = element_blank())
}
```

Change the IDs or dates to compare other participants. Keep the selection to five or fewer IDs so the labels remain readable.

```{r intensity-example}
comparison_ids <- head(ids, 5)  # Replace with up to five IDs from ids
start_date <- min(shared_dates)
end_date <- max(shared_dates)
plot_intensity_comparison(comparison_ids, start_date, end_date)
```

